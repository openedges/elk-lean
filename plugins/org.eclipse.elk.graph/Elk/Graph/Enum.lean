import Elk.Core.Util.FastFloat
/-!
# Java-style enumerations and `EnumSet`

`ElkEnum` exposes what ELK needs from a Java `enum`: the declaration order
(`ordinal`), the list of constants (`values`) and the Java constant name used in
option strings and JSON (`javaName`). The `elk_enum` command generates an
`inductive` together with the instance:

```lean
elk_enum Direction := undefined right left down up
elk_enum Weird := (foo "FOO_BAR") baz2
```

Java names default to UPPER_SNAKE_CASE of the constructor name.
`EnumSet α` is a bit set over ordinals (`java.util.EnumSet`).
-/
namespace Elk

/-- Interface of a Java-style enumeration. Instances are generated by `elk_enum`. -/
class ElkEnum (α : Type) where
  /-- All constants in declaration order (`Enum.values()`). -/
  values : Array α
  /-- Declaration index (`Enum.ordinal()`). -/
  ordinal : α → Nat
  /-- Java constant name (`Enum.name()`). -/
  javaName : α → String

namespace ElkEnum

variable {α : Type} [ElkEnum α]

/-- Number of constants. -/
def count : Nat := (values : Array α).size

/-- Constant with the given ordinal, if any. -/
def ofOrdinal? (n : Nat) : Option α := (values : Array α)[n]?

/-- `Enum.valueOf`: exact Java name lookup. -/
def ofJavaName? (s : String) : Option α := (values : Array α).find? (fun v => javaName v == s)

/-- Normalisation used for lenient enum parsing (elk-rs `normalize_enum_token`):
keep ASCII letters and digits only, upper-cased. `H_CENTER`, `hCenter` and
`h-center` all normalise to `HCENTER`. -/
def normalizeName (s : String) : String :=
  -- byte-wise (`Char.isAlphanum` is ASCII-only, so every other byte, including all bytes of
  -- multi-byte characters, is dropped); the `List Char` round trip showed up in import profiles
  let bs := s.toUTF8
  let out := bs.foldl (init := ByteArray.emptyWithCapacity bs.size) fun acc b =>
    if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) then acc.push b
    else if b >= 97 && b <= 122 then acc.push (b - 32)
    else acc
  (String.fromUTF8? out).getD ""

/-- Lenient lookup (elk-rs `parse_enum_value`): a decimal token selects by
ordinal, otherwise names are compared after `normalizeName`. -/
def ofNameLoose? (s : String) : Option α :=
  let t := s.trimAscii.toString
  if t.isEmpty then none
  else match t.toNat? with
    | some i => ofOrdinal? i
    | none =>
      let n := normalizeName t
      (values : Array α).find? (fun v => normalizeName (javaName v) == n)

end ElkEnum

/-- camelCase → UPPER_SNAKE_CASE (Java constant naming). Digits stay attached. -/
def camelToUpperSnake (s : String) : String :=
  let rec go : List Char → Bool → List Char
    | [], _ => []
    | c :: rest, prevLower =>
      if c.isUpper then
        (if prevLower then ['_', c] else [c]) ++ go rest false
      else
        c.toUpper :: go rest (c.isLower || c.isDigit)
  String.ofList (go s.toList false)

/-- Constructor of an `elk_enum`: `name` or `(name "JAVA_NAME")`. -/
syntax elkEnumCtor := ident <|> ("(" ident str ")")

/-- `elk_enum Name := a b (c "C_NAME")` declares a Java-like enumeration. -/
syntax (name := elkEnumCmd) (docComment)? "elk_enum " ident " := " elkEnumCtor+ : command

open Lean in
macro_rules
  | `($[$doc?:docComment]? elk_enum $name:ident := $ctors:elkEnumCtor*) => do
    let mut ctorIds : Array Ident := #[]
    let mut names : Array (TSyntax `str) := #[]
    for c in ctors do
      match c with
      | `(elkEnumCtor| $id:ident) =>
        ctorIds := ctorIds.push id
        names := names.push (Syntax.mkStrLit (camelToUpperSnake id.getId.toString))
      | `(elkEnumCtor| ($id:ident $s:str)) =>
        ctorIds := ctorIds.push id
        names := names.push s
      | _ => Macro.throwUnsupported
    let qids : Array Ident := ctorIds.map fun id => mkIdent (name.getId ++ id.getId)
    let nums : Array (TSyntax `num) :=
      (List.range ctorIds.size).toArray.map fun i => Syntax.mkNumLit (toString i)
    `($[$doc?:docComment]? inductive $name:ident where
        $[| $ctorIds:ident]*
        deriving BEq, Hashable, Repr, Inhabited, DecidableEq, Ord
      instance : Elk.ElkEnum $name where
        values := #[$qids,*]
        ordinal := fun $[| $qids:ident => $nums:num]*
        javaName := fun $[| $qids:ident => $names:str]*
      instance : ToString $name := ⟨Elk.ElkEnum.javaName⟩)

/-- `java.util.EnumSet`: a bit set over the ordinals of an `ElkEnum`.
At most 64 constants per enumeration (ELK's largest has 9). -/
structure EnumSet (α : Type) where
  bits : UInt64 := 0
  deriving BEq, Hashable, Repr, Inhabited, DecidableEq

namespace EnumSet

variable {α : Type} [ElkEnum α]

@[inline] def empty : EnumSet α := ⟨0⟩

/-- `EnumSet.noneOf`. -/
@[inline] def noneOf : EnumSet α := ⟨0⟩

@[inline] private def bit (x : α) : UInt64 := (1 : UInt64) <<< (ElkEnum.ordinal x).toUInt64

/-- `EnumSet.allOf`. -/
def allOf : EnumSet α :=
  ⟨(ElkEnum.values : Array α).foldl (fun acc x => acc ||| bit x) 0⟩

@[inline] def insert (s : EnumSet α) (x : α) : EnumSet α := ⟨s.bits ||| bit x⟩

@[inline] def erase (s : EnumSet α) (x : α) : EnumSet α := ⟨s.bits &&& ~~~(bit x)⟩

@[inline] def contains (s : EnumSet α) (x : α) : Bool := (s.bits &&& bit x) != 0

/-- `EnumSet.of(a, b, ...)`. -/
def of (xs : Array α) : EnumSet α := xs.foldl insert empty

/-- `EnumSet.of(a)`. -/
@[inline] def singleton (x : α) : EnumSet α := insert empty x

@[inline] def isEmpty (s : EnumSet α) : Bool := s.bits == 0

def union (s t : EnumSet α) : EnumSet α := ⟨s.bits ||| t.bits⟩
def inter (s t : EnumSet α) : EnumSet α := ⟨s.bits &&& t.bits⟩
def diff (s t : EnumSet α) : EnumSet α := ⟨s.bits &&& ~~~t.bits⟩

/-- `containsAll`. -/
def containsAll (s t : EnumSet α) : Bool := (t.bits &&& ~~~s.bits) == 0

/-- True if the sets share at least one element. -/
def containsAny (s t : EnumSet α) : Bool := (s.bits &&& t.bits) != 0

/-- Elements in ordinal order (Java iteration order). -/
def toArray (s : EnumSet α) : Array α :=
  (ElkEnum.values : Array α).filter (fun x => s.contains x)

def size (s : EnumSet α) : Nat := (s.toArray).size

/-- Java `EnumSet.toString()`: `[A, B]`. -/
def toJavaString (s : EnumSet α) : String :=
  "[" ++ ", ".intercalate ((s.toArray).toList.map ElkEnum.javaName) ++ "]"

instance : ToString (EnumSet α) := ⟨toJavaString⟩

/-- Lenient parse of `[A, B]`, `A B`, `A,B` or the empty set. Unknown names are
ignored, matching ELK's `LayoutOptionData.parseValue` for enum sets. -/
def parseLoose (s : String) : EnumSet α :=
  let body := (s.trimAscii.toString.replace "[" "").replace "]" ""
  let tokens := (body.replace "," " ").splitOn " "
  tokens.foldl (fun acc tok =>
    let t := tok.trimAscii.toString
    if t.isEmpty then acc
    else match (ElkEnum.ofNameLoose? t : Option α) with
      | some x => acc.insert x
      | none => acc) empty

end EnumSet

end Elk
