{
  "name": "@openedges/elk-lean",
  "version": "0.12.0",
  "description": "Eclipse Layout Kernel ported to pure Lean 4 (elk-lean) — elkjs-compatible API with a native Node.js addon and WASM fallback",
  "license": "EPL-2.0 OR GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openedges/elk-lean.git",
    "directory": "plugins/org.eclipse.elk.js"
  },
  "homepage": "https://github.com/openedges/elk-lean#readme",
  "bugs": {
    "url": "https://github.com/openedges/elk-lean/issues"
  },
  "main": "js/index.js",
  "browser": "js/index.browser.js",
  "types": "typings/elk-api.d.ts",
  "exports": {
    ".": {
      "types": "./typings/elk-api.d.ts",
      "browser": "./js/index.browser.js",
      "default": "./js/index.js"
    },
    "./js/*": "./js/*",
    "./package.json": "./package.json"
  },
  "files": [
    "js/",
    "dist/wasm/",
    "dist/wasm-node/",
    "typings/",
    "LICENSE.md",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build:napi": "sh ../../scripts/build_napi.sh",
    "test": "node --test test/",
    "test:parity": "node test/parity/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@openedges/elk-lean-darwin-arm64": "0.12.0",
    "@openedges/elk-lean-darwin-x64": "0.12.0",
    "@openedges/elk-lean-linux-x64-gnu": "0.12.0",
    "@openedges/elk-lean-linux-arm64-gnu": "0.12.0"
  },
  "keywords": [
    "elk",
    "elkjs",
    "layout",
    "graph",
    "lean4",
    "napi",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
